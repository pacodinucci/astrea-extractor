# Neon PostgreSQL
# Runtime connection string. Use Neon pooled URL when available.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"
# Direct connection string for Prisma CLI/migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-secure-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# OpenAI OCR
OPENAI_API_KEY="sk-..."
OPENAI_OCR_MODEL="gpt-4.1-mini"


# Astrea worker browser runtime
ASTREA_CDP_PORT="9222"
ASTREA_CHROMIUM_PATH=""
ASTREA_PROFILE_PATH=""ASTREA_MAX_PAGE_ATTEMPTS="3"
# Optional comma-separated page list for early worker tests before metadata is available.
ASTREA_WORKER_PAGES=""